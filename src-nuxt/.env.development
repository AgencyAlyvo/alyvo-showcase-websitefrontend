VITE_NODE_ENV=development

# Module Nuxt Robots : https://nuxtseo.com/docs/robots/guides/disable-indexing#handling-staging-environments
NUXT_SITE_ENV=development
# End Module Nuxt Robots

# Module Nuxt Sitemap : https://nuxtseo.com/docs/sitemap/getting-started/introduction
NUXT_PUBLIC_SITE_URL=http://localhost:1470
NUXT_SITE_NAME=Alyvo
# NUXT_SITE_ENV également mais déjà défini pour Nuxt Robots, pas besoin de le redéfinir ici
# End Module Nuxt Sitemap

VITE_BASE_URL_API=http://localhost:3500

# Dashboard (Audit SEO + Indexation Google) — accessible via /dashboard
# DASHBOARD_PASSWORD : mot de passe pour se connecter
# DASHBOARD_SESSION_TOKEN : valeur du cookie de session (longue chaîne aléatoire, ne pas partager)
DASHBOARD_PASSWORD=toto35!
DASHBOARD_SESSION_TOKEN=please-change-this-to-a-random-secret

# Site analysé pour l'audit SEO et l'indexation (par défaut : NUXT_PUBLIC_SITE_URL)
INDEXING_SITE_URL=https://alyvo.fr

# PageSpeed Insights API key
PSI_API_KEY=AIzaSyAA1uopmO2r2LbWncdFm9_RoLxSYVJBnT8

# Google Search Console
# Identifiant du site dans GSC. Soit "sc-domain:exemple.fr" (vérification domaine),
# soit l'URL exacte de la propriété "https://exemple.fr/" (vérification URL).
# Par défaut : valeur de INDEXING_SITE_URL
# GSC_SITE_URL=sc-domain:exemple.fr

